# URL where the app is hosted
APP_BASE_URL=http://localhost:8080
# Database URL with connection pool optimization
# For production, add connection pool parameters to prevent connection exhaustion:
# DATABASE_URL=postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=20&connect_timeout=10
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terpa-web-local
DATABASE_POOLED_URL=postgresql://postgres:postgres@localhost:5432/terpa-web-local
# Redis URL
REDIS_URL=redis://localhost:6379
# Exchange rate API URL
BANXICO_API_KEY=your-banxico-api-key
# JWT Secret
JWT_SECRET=very-secret-key
# URL of the TERPA DEX service
TERPA_DEX_SERVICE_URL=http://localhost:3030
# Pharos URL
PHAROS_TOKEN=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_TOKEN=your-mercadopago-webhook-token

# Cron
CRON_SECRET=your-cron-secret

# DigitalOcean Spaces Configuration
SPACES_REGION="sfo3" # Your space region (e.g., sfo3, nyc3, ams3)
SPACES_BUCKET="terpa"
SPACES_KEY="your-spaces-access-key"
SPACES_SECRET="your-spaces-secret-key"

# Facturama Configuration
FACTURAMA_USERNAME=your-facturama-username
FACTURAMA_PASSWORD=your-facturama-password
FACTURAMA_API_URL=https://apisandbox.facturama.mx

# Sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
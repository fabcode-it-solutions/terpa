# Public runtime config (bundled in the app; do NOT put secrets here)
# Values prefixed with EXPO_PUBLIC_ are exposed to the JS bundle.
#+
# ENV FILES
# app.config.ts auto-loads, in order (later overrides earlier):
#   .env, .env.local, .env.<profile>, .env.<profile>.local
# <profile> is EAS_BUILD_PROFILE (CI) or APP_ENV (local) or NODE_ENV-derived
# Common profiles: development, preview, production

# Default template values
EXPO_PUBLIC_API_BASE_URL=https://l9v93b62-8080.inc1.devtunnels.ms
EXPO_PUBLIC_DEFAULT_TEAM_ID=team-123
EXPO_PUBLIC_DEMO_AUTH=false

# Example: override for local device testing
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
